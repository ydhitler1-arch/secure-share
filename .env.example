# Copy to .env (docker compose reads it automatically) and edit. Every value is optional.

# Public address of the site, used in verification and reset emails.
BASE_URL=https://share.example.com

# Behind an HTTPS reverse proxy (recommended for anything public):
SECURE_COOKIES=1
TRUST_PROXY=1

# Real email delivery (leave SMTP_HOST empty to log emails to /data/outbox.log instead).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SecureShare <noreply@example.com>

# Sign in with Google (optional). Create an OAuth client in Google Cloud Console; the redirect URI is
# BASE_URL + /auth/google/callback. See the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anonymous storage quotas in MB.
ANON_IP_QUOTA_MB=100
ANON_TOTAL_QUOTA_MB=1024
